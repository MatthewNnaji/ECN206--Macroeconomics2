PennUK <- PENN %>%
filter(countrycode=='GBR')
colnames(PennUK)
UKData <- PennUK %>%
select('year','rgdpna','pop','avh','rnna','hc')
names(UKData) <- c('Year','RGDP','Population','AvgHrs','CapitalStock','HC')
View(UKData)
UKData <- UKData %>%
mutate(RGDPCapita = RGDP/Population)
UKData <- UKData %>%
relocate(RGDPCapita, .after=RGDP)
glimpse(UKData)
timeGDPplot1 <- UKData %>%
ggplot() + geom_line(mapping=aes(x=RGDP,y=Year),colour='steelblue')
view(timeGDPplot1)
print(timeGDPplot1)
timeGDPplot1 <- UKData %>%
ggplot() + geom_line(mapping=aes(x=Year,y=RGDP),colour='steelblue')
print(timeGDPplot1)
timeGDPplot2 <- UKData %>%
ggplot() + geom_line(mapping=aes(x=Year,y=RGDP),colour='royalblue4') + scale_y_continuous(transform='log10')
print(timeGDPplot2)
